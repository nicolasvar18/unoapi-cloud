# ==============================================================================
# CONFIGURACIÓN DE UNOAPI CLOUD (PLANTILLA PARA ENTORNO)
# Copia este archivo como .env y coloca tus credenciales personalizadas.
# NUNCA subas tu archivo .env real a repositorios públicos.
# ==============================================================================

# Token Maestro para la API de Unoapi y Panel Web
UNOAPI_AUTH_TOKEN=tu_token_secreto_unoapi

# Configuración de MinIO / Amazon S3 (Almacenamiento de fotos, audios y documentos)
STORAGE_BUCKET_NAME=unoapi
STORAGE_ACCESS_KEY_ID=usuario_minio
STORAGE_SECRET_ACCESS_KEY=clave_minio
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_FORCE_PATH_STYLE=true

MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SITE_REGION=us-east-1
MINIO_ROOT_USER=usuario_minio
MINIO_ROOT_PASSWORD=clave_minio

# Configuración de RabbitMQ (Gestor de Colas de Mensajería)
RABBITMQ_DEFAULT_USER=usuario_rabbitmq
RABBITMQ_DEFAULT_PASS=clave_rabbitmq
AMQP_URL=amqp://usuario_rabbitmq:clave_rabbitmq@rabbitmq:5672?frameMax=8192

# Configuración de Redis (Base de datos en memoria para sesiones de WhatsApp)
REDIS_PASSWORD=clave_redis
REDIS_URL=redis://:clave_redis@redis:6379

# Configuración de Comportamiento de WhatsApp
IGNORE_GROUP_MESSAGES=true
IGNORE_BROADCAST_STATUSES=true
REJECT_CALLS=Hola, no puedo responder llamadas por WhatsApp en este momento, ¿podrías escribirme un mensaje?
REJECT_CALLS_WEBHOOK=Te estaba llamando por WhatsApp...
SEND_CONNECTION_STATUS=true
DEFAULT_LOCALE=es

# Nombre del Dispositivo mostrado en WhatsApp celular
CONFIG_SESSION_PHONE_CLIENT=Unoapi
CONFIG_SESSION_PHONE_NAME=Chrome

# Credenciales de Acceso al Panel Web (https://wapp-services.appoio.site)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=clave_panel_web

# Configuración de Servidor de Correo (SMTP) para Alertas de Desconexión
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion_gmail
SMTP_FROM=Unoapi Alertas <tu_correo@gmail.com>
SMTP_SECURE=false
# Correos por defecto de alerta (separados por coma, opcional si se configuran en el panel)
ALERT_EMAILS=
